# Токен вашего Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Расписание проверки цен (cron формат)
# По умолчанию: каждые 30 минут (*/30 * * * *)
# Для частой проверки при тестировании: раз в 2 минуты (*/2 * * * *)
CHECK_INTERVAL_CRON=*/30 * * * *

# Путь к файлу базы данных SQLite
DATABASE_PATH=./data/tracker.db

# Опциональный прокси для запросов к API (например: http://user:pass@proxy-ip:port)
# PROXY_URL=

# Кастомный endpoint для Ozon API (если используется собственный прокси-сервис или шлюз)
# OZON_API_BASE=https://api.ozon.ru

# Демонстрационный режим (true/false)
# В demo-режиме бот генерирует реалистичные колебания цен для проверки уведомлений без блокировок
DEMO_MODE=false
